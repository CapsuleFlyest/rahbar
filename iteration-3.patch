+  LLM_TIMEOUT_SECONDS: "45"
+  # Groq free tier is rate limited (429). Retry this many times, waiting Retry-After (or 1, 2, 4 s),
+  # but never longer than LLM_RETRY_MAX_WAIT_SECONDS for one wait.
+  LLM_MAX_RETRIES: "2"
+  LLM_RETRY_MAX_WAIT_SECONDS: "20"
 
